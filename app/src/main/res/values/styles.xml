<resources>
    <style name="Theme.PresenceGuard" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tide</item>
        <item name="android:statusBarColor">@color/tide</item>
        <item name="android:navigationBarColor">@color/tide</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/tide</item>
    </style>

    <style name="Tide.Kicker">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:textColor">#D6DEFA</item>
    </style>

    <style name="Tide.Hero">
        <item name="android:textSize">88sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textScaleX">1.08</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="Tide.Head">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textScaleX">1.08</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Tide.Body">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#D6DEFA</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Tide.Meta">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">#D6DEFA</item>
    </style>

    <style name="Tide.Button" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tideDeep</item>
        <item name="android:backgroundTint">#FFFFFF</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Tide.Button.Ghost" parent="Tide.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">#00000000</item>
        <item name="android:strokeColor">#40FFFFFF</item>
        <item name="android:strokeWidth">1.5dp</item>
    </style>

    <style name="Tide.Button.Amber" parent="Tide.Button">
        <item name="android:textColor">#1A1200</item>
        <item name="android:backgroundTint">@color/amber</item>
    </style>
</resources>
